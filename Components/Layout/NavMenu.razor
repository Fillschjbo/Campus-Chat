@inject ChatService chat
@inject CurrentUserService CurrentUser
@inject NavigationManager nav

@implements IDisposable


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CampusChat</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (user == null)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="signin">Sign in</NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <h3 style="color: whitesmoke;">Logged in as @chat.GetProfileById(CurrentUser.CurrentUserId.Value).DisplayName</h3>
                <button @onclick="CurrentUser.SignOutAsync" style="height: 28px; width: 80%;">Sign out</button>
            </div>
        }
        
    </nav>
</div>

@code {
    private Profile? user;

    private void LoadUser()
    {
        if (CurrentUser.CurrentUserId == null)
        {
            user = null;
            InvokeAsync(StateHasChanged);
        }
        else
        {
            user = chat.GetProfileById(CurrentUser.CurrentUserId.Value);
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnUserChanged()
    {
       LoadUser();
       InvokeAsync(StateHasChanged);
    }
    
    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += OnUserChanged;
        LoadUser();
    }
    
    public void Dispose()
    {
        CurrentUser.UserChanged -= OnUserChanged;
    }

}

