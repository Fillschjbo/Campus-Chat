@page "/profile/{Id:int}"

@inject CurrentUserService CurrentUser
@inject ChatService Chat
@inject NavigationManager nav


<div style="min-height: 100vh; padding: 40px 20px; background: #f5f7fb; font-family: Inter, Arial, sans-serif; color: #1e293b;">

    @if (profile == null)
    {
        <div style="max-width: 480px; margin: 60px auto; padding: 40px; text-align: center; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
            <h3 style="margin: 0 0 12px; font-size: 22px; color: #1e293b;">
                The user you're searching for doesn't exist!
            </h3>
            <p style="margin: 0; color: #64748b; font-size: 15px;">
                Please try again.
            </p>
        </div>
    }
    else
    {
        <div style="max-width: 800px; margin: 0 auto; padding: 32px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 20px; box-shadow: 0 8px 30px rgba(15,23,42,0.04);">

            <div style="margin-bottom: 24px;">
                <h2 style="margin: 0 0 10px; font-size: 28px; font-weight: 700; letter-spacing: -0.5px;">
                    @profile.DisplayName
                </h2>
                <p style="margin: 0 0 8px; color: #64748b; font-size: 15px; line-height: 1.6;">
                    @profile.Note
                </p>
                <p style="margin: 0; color: #4f46e5; font-size: 14px; font-weight: 600;">
                    @profile.Role
                </p>
            </div>

            <div style="display: inline-flex; align-items: center; gap: 10px; margin-bottom: 28px; padding: 9px 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 999px;">
                <div style="background: @profile.AvatarColorHex; width: 10px; height: 10px; border-radius: 50%;"></div>
                @if (profile.Year != 0)
                {
                    <p style="margin: 0; color: #475569; font-size: 13px; font-weight: 600;">
                        @profile.Year Year student
                    </p>
                }
            </div>
            
            @if (profile.UserId == CurrentUser.CurrentUserId)
            {
                <a href="/profile/edit"
                   style="display: inline-block; margin-bottom: 20px; padding: 10px 16px; background: #eef2ff; color: #4f46e5; border: 1px solid #e0e7ff; border-radius: 10px; font-family: Inter, Arial, sans-serif; font-size: 14px; font-weight: 600; text-decoration: none;">
                    Edit profile
                </a>
            }

            <div style="border-top: 1px solid #e2e8f0; padding-top: 24px;">
                <h3 style="margin: 0 0 20px; font-size: 20px; font-weight: 700;">
                    Threads joined by: @profile.DisplayName
                </h3>

                
                @if (threads.Count == 0)
                    {
                        <div style="max-width: 480px; margin: 60px auto; padding: 40px; text-align: center; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.04);">
                            <h3 style="margin: 0 0 12px; font-size: 22px; color: #1e293b;">
                                This user has not joined any threads
                            </h3>
                        </div>
                    }
                else
                    {
                    foreach (var thread in threads)
                    {
                        if (thread.IsPrivate == true)
                        {
                            <a href="/threads/@thread.ThreadId" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; padding: 18px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;">
                                <h3 style="margin: 0; font-size: 16px; font-weight: 600; overflow-wrap: anywhere;">
                                    @thread.Name
                                </h3>
                                <p style="flex-shrink: 0; margin: 0; padding: 6px 10px; background: #fff7ed; color: #9a3412; border-radius: 8px; font-size: 12px; font-weight: 600;">
                                    Private
                                </p>
                            </a>
                        }
                        else
                        {
                            <a href="/threads/@thread.ThreadId" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; padding: 18px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px;">
                                <h3 style="margin: 0; font-size: 16px; font-weight: 600; overflow-wrap: anywhere;">
                                    @thread.Name
                                </h3>
                                <p style="flex-shrink: 0; margin: 0; padding: 6px 10px; background: #ecfdf5; color: #047857; border-radius: 8px; font-size: 12px; font-weight: 600;">
                                    Public
                                </p>
                            </a>
                        }  
                    }
                   
                }
            </div>

        </div>
    }

</div>


@code
{
    [Parameter] public int Id { get; set; }
    private IReadOnlyList<ChatThread> threads = [];
    private Profile? profile;
    
    protected override void OnParametersSet()
    {
        profile = Chat.GetProfileById(Id);
        threads = Chat.GetChatThreadsJoinedBy(Id);
    }
}