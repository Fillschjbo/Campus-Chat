@page "/"

@inject ChatService Chat
@inject CurrentUserService CurrentUser

@implements IDisposable

<div style="min-height: 100vh; padding: 40px 20px; background: #f5f7fb; font-family: Inter, Arial, sans-serif; color: #1e293b;">

    <div style="max-width: 800px; margin: 0 auto;">

        <h2 style="margin: 0 0 8px; font-size: 28px; font-weight: 700; letter-spacing: -0.5px;">
            Threads
        </h2>

        <p style="margin: 0 0 24px; color: #64748b; font-size: 14px; line-height: 1.6;">
            Explore conversations, find your community, and join the discussion.
        </p>

        @if (CurrentUser.CurrentUserId == null)
        {
            <div style="margin-bottom: 32px; padding: 20px; background: #eef2ff; border: 1px solid #e0e7ff; border-radius: 14px;">
                <p style="margin: 0; color: #4338ca; font-size: 14px;">
                    Sign in to join threads and participate in conversations.
                </p>
                <a href="/signin"
                   style="display: inline-block; margin-top: 12px; color: #4338ca; font-size: 14px; font-weight: 700; text-decoration: none;">
                    Sign in →
                </a>
            </div>
        }
        else
        {
            <div style="margin-bottom: 36px;">
                <h3 style="margin: 0 0 16px; font-size: 20px; font-weight: 700;">
                    My threads
                </h3>

                @if (myThreads.Count == 0)
                {
                    <div style="padding: 24px; background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 14px;">
                        <p style="margin: 0; color: #64748b; font-size: 14px; line-height: 1.6;">
                            You haven't joined any threads yet. Open one below to join.
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var thread in myThreads)
                    {
                        <a href="@($"/threads/{thread.ThreadId}")"
                           style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 10px; padding: 18px 20px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 12px; color: #1e293b; text-decoration: none;">
                            <span style="font-size: 15px; font-weight: 600; overflow-wrap: anywhere;">
                                @thread.Name
                            </span>
                            
                            @if (unreadCounts.TryGetValue(thread.ThreadId, out var count) && count > 0)
                            {
                                <span style="flex-shrink: 0; padding: 5px 9px; background: #4f46e5; color: #ffffff; border-radius: 999px; font-size: 12px; font-weight: 700;">
                                    @count unread
                                </span>
                            }

                            @if (thread.IsPrivate)
                            {
                                <span style="flex-shrink: 0; padding: 6px 10px; background: #fff7ed; color: #9a3412; border-radius: 8px; font-size: 12px; font-weight: 600;">
                                    🔒 Private
                                </span>
                            }
                        </a>
                    }
                }
            </div>
        }

        <div style="border-top: 1px solid #e2e8f0; padding-top: 28px;">

            <h3 style="margin: 0 0 8px; font-size: 20px; font-weight: 700;">
                Explore all threads
            </h3>

            <p style="margin: 0 0 18px; color: #64748b; font-size: 14px;">
                Browse all available conversations, including private threads.
            </p>

            <input type="search"
                   @bind="query"
                   @bind:event="oninput"
                   @bind:after="SearchThreads"
                   placeholder="Search threads..."
                   aria-label="Search threads by name"
                   style="box-sizing: border-box; width: 100%; margin-bottom: 20px; padding: 14px 16px; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 12px; outline: none; font-family: Inter, Arial, sans-serif; font-size: 14px; color: #1e293b;" />

            @if (threads.Count == 0)
            {
                <div style="padding: 32px 20px; background: #ffffff; border: 1px dashed #cbd5e1; border-radius: 14px; text-align: center;">
                    <p style="margin: 0; color: #64748b; font-size: 14px;">
                        @if (string.IsNullOrWhiteSpace(query))
                        {
                            <span>No threads available.</span>
                        }
                        else
                        {
                            <span>No threads match '@query'.</span>
                        }
                    </p>
                </div>
            }
            else
            {
                @foreach (var thread in threads)
                {
                    <a href="@($"/threads/{thread.ThreadId}")"
                       style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 12px; padding: 20px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 14px; color: #1e293b; text-decoration: none;">

                        <div style="min-width: 0;">
                            <div style="font-size: 15px; font-weight: 700; overflow-wrap: anywhere;">
                                @thread.Name
                            </div>
                            <div style="margin-top: 5px; color: #64748b; font-size: 12px;">
                                Open conversation →
                            </div>
                        </div>
                        
                        @if (unreadCounts.TryGetValue(thread.ThreadId, out var count) && count > 0)
                        {
                            <span style="flex-shrink: 0; padding: 5px 9px; background: #4f46e5; color: #ffffff; border-radius: 999px; font-size: 12px; font-weight: 700;">
                                @count unread
                            </span>
                        }

                        @if (thread.IsPrivate)
                        {
                            <span style="flex-shrink: 0; padding: 6px 10px; background: #fff7ed; color: #9a3412; border-radius: 8px; font-size: 12px; font-weight: 600;">
                                🔒 Private
                            </span>
                        }
                    </a>
                }
            }
        </div>
    </div>
</div>

@code {
    private string query = "";
    private IReadOnlyList<ChatThread> threads = [];
    private IReadOnlyList<ChatThread> myThreads = [];
    private IReadOnlyDictionary<int, int> unreadCounts = new Dictionary<int, int>();

    protected override void OnInitialized()
    {
        CurrentUser.UserChanged += OnStateChanged;
        Chat.MembershipChanged += OnStateChanged;
        Chat.PostsChanged += OnStateChanged;
        Chat.ReadStateChanged += OnStateChanged;

        ReloadLists();
        LoadUnreadCounts();
    }

    private void SearchThreads()
    {
        threads = Chat.GetAllThreads(query);
    }
    
    private void LoadUnreadCounts()
    {
        if (CurrentUser.CurrentUserId is int userId)
        {
            unreadCounts = Chat.GetUnreadCounts(userId);
        }
        else
        {
            unreadCounts = new Dictionary<int, int>();
        }
    }

    private void ReloadLists()
    {
        threads = Chat.GetAllThreads(query);

        if (CurrentUser.CurrentUserId is int userId)
        {
            myThreads = Chat.GetChatThreadsJoinedBy(userId);
        }
        else
        {
            myThreads = [];
        }
        LoadUnreadCounts();
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(() =>
        {
            ReloadLists();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        CurrentUser.UserChanged -= OnStateChanged;
        Chat.MembershipChanged -= OnStateChanged;
        Chat.PostsChanged -= OnStateChanged;
        Chat.ReadStateChanged -= OnStateChanged;
    }
}